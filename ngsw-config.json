{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/main-*.js",
          "/chunk-*.js"
        ]
      }
    },
    {
      "name": "lektionen",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/lektionen/**",
          "/bilder/**",
          "/icons/**"
        ]
      }
    },
    {
      "name": "pdf-worker",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": [
          "/worker-*.js"
        ]
      }
    }
  ]
}
